+function StatusBadge({ status }: { status: string }) {
+  const map: Record<string, string> = {
+    COMPLETED: 'bg-[#DCFCE7] text-[#166534]',
+    PENDING: 'bg-amber-50 text-amber-700',
+    FAILED: 'bg-red-50 text-red-600',
